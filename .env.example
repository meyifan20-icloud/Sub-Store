# Sub-Store self-host defaults
# Copy this file to .env before Docker Compose use.
# IMPORTANT: change SUB_STORE_FRONTEND_BACKEND_PATH to your own long random path.

TZ=Asia/Shanghai

# Public/merged frontend + backend service
SUB_STORE_BACKEND_API_HOST=0.0.0.0
SUB_STORE_BACKEND_API_PORT=3001
SUB_STORE_BACKEND_MERGE=true
SUB_STORE_BACKEND_PREFIX=
SUB_STORE_FRONTEND_BACKEND_PATH=/2cXaAxRGfddmGz2yx1wA
SUB_STORE_FRONTEND_PATH=/opt/app/frontend
SUB_STORE_DATA_BASE_PATH=/opt/app/data

# Browser CORS. Keep the official frontend origins unless you use your own frontend domain.
SUB_STORE_CORS_ALLOWED_ORIGINS=https://sub-store.vercel.app,http://substore.stash,https://substore.stash

# Request/runtime tuning
SUB_STORE_MAX_HEADER_SIZE=32768
SUB_STORE_BODY_JSON_LIMIT=1mb
SUB_STORE_BACKEND_DEFAULT_PROXY=

# Notifications
# Supports ordinary HTTP URLs and shoutrrr URLs.
SUB_STORE_PUSH_SERVICE=

# Scheduled jobs
SUB_STORE_BACKEND_SYNC_CRON=
SUB_STORE_BACKEND_UPLOAD_CRON=
SUB_STORE_BACKEND_DOWNLOAD_CRON=
SUB_STORE_PRODUCE_CRON=

# Remote restore
SUB_STORE_DATA_URL=
SUB_STORE_DATA_URL_POST=

# MMDB
SUB_STORE_MMDB_COUNTRY_PATH=/opt/app/data/GeoLite2-Country.mmdb
SUB_STORE_MMDB_ASN_PATH=/opt/app/data/GeoLite2-ASN.mmdb
SUB_STORE_MMDB_CRON=
SUB_STORE_MMDB_COUNTRY_URL=
SUB_STORE_MMDB_ASN_URL=

# Display/response customization
SUB_STORE_BACKEND_CUSTOM_NAME=
SUB_STORE_BACKEND_CUSTOM_ICON=
SUB_STORE_X_POWERED_BY=

# HTTP-META + mihomo (included in the self-built Docker image)
HTTP_META_ENABLED=true
HTTP_META_HOST=127.0.0.1
HTTP_META_PORT=9876
META_DISABLE_AUTO_CLEAN=false
META_TEMP_FOLDER=/tmp/http-meta
BODY_JSON_LIMIT=1mb
